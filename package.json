{
  "name": "react-ui-kit",
  "version": "0.1.0",
  "description": "A generic React component library. Currently ships Table: a responsive table with sorting, filtering, search, pagination/lazy-load, action menus, and expandable (accordion / nested table) rows.",
  "type": "module",
  "main": "./dist/react-ui-kit.cjs",
  "module": "./dist/react-ui-kit.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-ui-kit.mjs",
      "require": "./dist/react-ui-kit.cjs"
    },
    "./style.css": "./dist/react-ui-kit.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "react",
    "component-library",
    "ui-kit",
    "table",
    "data-table",
    "pagination",
    "sorting",
    "filtering"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "cd demo && vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p demo/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "lint": "oxlint",
    "preview:demo": "cd demo && vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^8.6.18",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1"
  }
}
